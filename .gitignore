# LUMORA — track only project files (child theme, README, docs).
# Everything else (core, secrets, DB, uploads, Local runtime) is excluded.

# --- WordPress core ---
/app/public/wp-admin/
/app/public/wp-includes/
/app/public/wp-*.php
/app/public/index.php
/app/public/license.txt
/app/public/readme.html
/app/public/xmlrpc.php
/app/public/.htaccess

# --- Secrets & config ---
/app/public/wp-config.php
/app/public/wp-config-sample.php
*.sql
*.sqlite
.env
.envrc

# --- Dependencies & generated ---
/app/public/wp-content/plugins/
/app/public/wp-content/mu-plugins/
/app/public/wp-content/upgrade/
/app/public/wp-content/uploads/
/app/public/wp-content/cache/
/app/public/wp-content/elementor/
/app/public/wp-content/et-cache/
node_modules/
vendor/

# --- Parent + default themes (unmodified, reinstallable) ---
/app/public/wp-content/themes/hello-elementor/
/app/public/wp-content/themes/twentytwenty*/

# --- Local runtime ---
/conf/
/logs/
*.log
.DS_Store
Thumbs.db

# --- Local / WP silence files (not project code) ---
/app/public/local-xdebuginfo.php
/app/public/wp-content/index.php
/app/public/wp-content/themes/index.php
/app/public/wp-content/plugins/index.php

# --- Elementor / editor caches ---
**/elementor/css/
**/.elementor/

# --- Temp ---
/tmp/
/temp/
*.tmp
*.bak
*~

# --- Keep project files (negations for clarity; git only adds what we stage) ---
!/app/public/wp-content/themes/lumora-child/
!/README.md
!/.gitignore
!/docs/
